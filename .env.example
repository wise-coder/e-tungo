MONGODB_URI=
MONGODB_DB_NAME=e_tungo
# Public production origin used for canonical URLs, sitemap, robots and social metadata.
# Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=https://e-tungo.tungatechnologies.com
# Optional server-only origin for syncing company-page copy from a separate
# legacy site or CMS. It must differ from NEXT_PUBLIC_SITE_URL.
COMPANY_CONTENT_SOURCE_URL=
# Exact browser origin, without a trailing slash. HTTPS is required in production.
APP_ORIGIN=http://localhost:3000
# Optional: the existing user ID that receives admin access. No default admin exists.
ADMIN_USER_ID=
# Server-only password recovery email credentials. Not needed for signup/login.
# Use a verified sender domain.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Set only when your trusted reverse proxy OVERWRITES this header and direct
# connections to the app are blocked. Otherwise a shared source limit is used.
AUTH_TRUSTED_IP_HEADER=
# Optional absolute path for persistent SQLite storage; use MongoDB for replicas.
SQLITE_PATH=
